{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["src/platform/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/rpc"]
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
