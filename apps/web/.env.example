# The PostHog project token. Without it, analytics never starts.
VITE_POSTHOG_KEY=

# The Sentry DSN. Without it, error reporting and tracing never start.
VITE_SENTRY_DSN=
# The release the page reports, so source maps match. The deploy sets it to the commit.
VITE_SENTRY_RELEASE=
# Build only: uploads source maps to Sentry. Never put it in a VITE_ variable.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
